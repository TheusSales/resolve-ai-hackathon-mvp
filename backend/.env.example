# Copie este arquivo para ".env" e ajuste os valores

# String de conexão com o Postgres
DATABASE_URL=postgres://resolveai:resolveai@localhost:5432/resolveai

# Chave usada para assinar os tokens JWT (troque em produção!)
JWT_SECRET=troque-essa-chave-em-producao

# Porta em que o servidor Express vai rodar
PORT=3000
